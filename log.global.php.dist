<?php

declare(strict_types=1);

use Dot\Log\Factory\LoggerFactory;
use Dot\Log\Logger;

return [
    'dependencies' => [
        'factories' => [
            // register one entry per logger defined under dot_log.loggers
            'dot-log.default_logger' => LoggerFactory::class,
        ],
    ],
    'dot_log'      => [
        'loggers' => [
            'default_logger' => [
                'writers' => [
                    'FileWriter' => [
                        // writer plugin: "stream", "noop", or a class implementing Dot\Log\Writer\WriterInterface
                        'name'    => 'stream',
                        // optional priority among the writers of this logger, default 1
                        'level'   => Logger::ALERT,
                        'options' => [
                            // {Y}, {m}, {d} and other date() characters are replaced with the current date
                            'stream'       => 'log/error-log-{Y}-{m}-{d}.log',
                            // optional, default "simple"; use "json" for one JSON object per line
                            'formatter'    => [
                                'name' => 'json',
                            ],
                            'filters'      => [
                                'importantMessages' => [
                                    'name'    => 'level',
                                    'options' => [
                                        'operator' => '<=',
                                        'level'    => Logger::WARN,
                                    ],
                                ],
                            ],
                            // optional; null or omitted disables the deletion of old log files.
                            // An integer deletes this writer's log files older than that many days.
                            'log_lifetime' => null,
                        ],
                    ],
                ],
            ],
        ],
    ],
];
