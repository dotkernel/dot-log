{
    "name": "dotkernel/dot-log",
    "type": "library",
    "description": "Dotkernel PSR-3 logger with writers, filters, formatters and processors, usable with any PSR-11 container",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-log",
    "keywords": [
      "log",
      "logging",
      "services",
      "PSR-3"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-stdlib": "^3.19",
        "psr/container": "^1.1 || ^2.0",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.19",
        "laminas/laminas-coding-standard": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "provide": {
        "psr/log-implementation": "3.0.0"
    },
    "suggest": {
        "laminas/laminas-validator": "To use Laminas validators with the Dot\\Log\\Filter\\Validator filter"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Log\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "static-analysis": "phpstan analyse --memory-limit 1G"
    }
}
